{
  "name": "separate-web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build",
    "build:node": "NITRO_PRESET=node-server nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "npm run build && wrangler dev",
    "prepare": "node -e \"if (!process.env.CF_PAGES && !process.env.CI) process.exit(1)\" || nuxt prepare",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "nuxt": "4.4.6",
    "playwright": "1.60.0",
    "sharp": "0.34.5"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "0.131.0",
    "@oxc-transform/binding-linux-x64-gnu": "0.131.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.92.0"
  }
}
