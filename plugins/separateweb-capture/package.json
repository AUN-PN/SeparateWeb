{
  "name": "separateweb-capture",
  "version": "1.0.0",
  "description": "Capture web pages into full-page screenshots, grouped UI item crops, and JSON manifests.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "capture",
    "screenshot",
    "playwright",
    "ui-extraction",
    "codex",
    "claude"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "separateweb": "./scripts/capture.mjs"
  },
  "files": [
    ".codex-plugin",
    "assets",
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "scripts",
    "skills"
  ],
  "scripts": {
    "capture": "node ./scripts/capture.mjs capture",
    "check": "node --check ./scripts/capture.mjs"
  },
  "dependencies": {
    "playwright": "1.60.0",
    "sharp": "0.34.5"
  }
}
